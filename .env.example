APP_ENV=development
LOG_LEVEL=INFO
# Local LLM runtime: auto | ollama | vllm | hf | heuristic
LOGAGENT_LLM_BACKEND=auto
LOGAGENT_MODEL=qwen2.5:3b
# Pipeline paths
RAW_LOG_DIR=data/raw_logs
GOLDEN_SCENARIOS=data/golden/scenarios.json
XAI_REPORT_DIR=docs/xai_reports
# Alerting sink (legacy adapters)
ALERT_CHANNEL=console
ALERT_WEBHOOK_URL=https://example.com/api/v1/alerts
ALERT_API_KEY=mock_key_replace_in_env
